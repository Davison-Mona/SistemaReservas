@{ ViewData["Title"] = "Nueva Contraseña"; }

<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow border-0 rounded-4 p-4">
        <h4 class="fw-bold mb-3">Restablecer Contraseña</h4>

        @if (ViewBag.Error != null) { <div class="alert alert-danger small">@ViewBag.Error</div> }

        <form asp-action="RestablecerContrasena" method="post">
            <input type="hidden" name="token" value="@ViewBag.Token" />
            <input type="hidden" name="email" value="@ViewBag.Email" />

            <div class="mb-3">
                <label class="form-label small fw-semibold">Nueva Contraseña</label>
                <input type="password" name="nuevaContrasena" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-success w-100 fw-semibold">Cambiar Contraseña</button>
        </form>
    </div>
</div>